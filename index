const Tooltip = ({ content }) => {
  const [isVisible, setIsVisible] = useState(false);
  return (
    <div className="relative inline-block ml-2 group">
      <button 
        className="text-[#f8cc74] opacity-60 hover:opacity-100 transition-opacity cursor-help"
        onMouseEnter={() => setIsVisible(true)}
        onMouseLeave={() => setIsVisible(false)}
        onClick={() => setIsVisible(!isVisible)}
        aria-label="More information"
      >
        <Info size={13} strokeWidth={2} />
      </button>
      
      {/* Tooltip Popup */}
      <div className={`
        absolute z-50 bottom-full left-1/2 transform -translate-x-1/2 mb-3 w-64 p-4 
        bg-[#111111] text-[#ead9bd] text-xs font-light leading-relaxed rounded-xl 
        border border-[#f8cc74]/20 shadow-2xl
        transition-all duration-200 pointer-events-none
        ${isVisible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-2'}
      `}>
        {content}
      </div>
    </div>
  );
};

